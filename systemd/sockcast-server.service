[Unit]
Description=Sockcast Coordinator Server (Roaming SSH Agent Router)
Documentation=https://github.com/theraphim/sockcast-server
After=network-online.target sockcast-server.socket
Wants=network-online.target sockcast-server.socket

[Service]
Type=simple
DynamicUser=yes
ConfigurationDirectory=sockcast::ro
ConfigurationDirectoryMode=0755
ExecStart=/usr/bin/sockcast-server --config ${CONFIGURATION_DIRECTORY}/server.toml
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
Also=sockcast-server.socket
